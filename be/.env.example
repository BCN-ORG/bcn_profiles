# Server
APP_PORT=3000
HOST_PORT=18085
FE_APP_PORT=3000
FE_HOST_PORT=18087
PORT=3000 # optional
SERVICE_NAME=profile_api # optional
NODE_ENV=development # optional (use production on server)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001 # optional
APP_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3001

# --- Local Docker infra (docker compose up) ---
# Postgres published on host :5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/profiles?schema=public # optional, generated on production
# Redis on host :6379 (leave REDIS_HOST empty so REDIS_URL is used)
REDIS_URL=redis://localhost:6379 # optional, disabled on production
REDIS_HOST= # optional
REDIS_PORT=6379
REDIS_PASSWORD= # optional
REDIS_PREFIX=profiles:

# Shared production PostgreSQL (CI/server). Prefer DATABASE_URL locally.
DB_HOST=postgres # optional on local when DATABASE_URL is set
DB_PORT=5432
DB_DATABASE=profiles
DB_USERNAME=profiles_app
DB_PASSWORD=
DB_SCHEMA=public
DB_POOL_MAX=10 # optional
DB_POOL_MIN=1 # optional
DB_POOL_IDLE_MS=300000 # optional
DB_POOL_CONNECT_TIMEOUT_MS=10000 # optional

# JWT (access and refresh must use different secrets)
JWT_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me

# BCN OAuth / SSO (PEM can contain escaped newlines or be base64 encoded)
OAUTH_ISSUER=http://localhost:3000/api
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900 # optional
JWT_RS256_KID=bcn-profiles-2026-01
# Prefer *_FILE locally (avoid multiline PEM in .env). Leave KEY empty when using FILE.
JWT_RS256_PRIVATE_KEY=
JWT_RS256_PUBLIC_KEY= # optional, derived from private key when unset
JWT_RS256_PRIVATE_KEY_FILE= # optional, local only
JWT_RS256_PUBLIC_KEY_FILE= # optional, local only
# Generate: mkdir -p secrets && openssl genrsa -out secrets/jwt-rs256.pem 2048
#           openssl rsa -in secrets/jwt-rs256.pem -pubout -out secrets/jwt-rs256.pub.pem
# Local: set the two *_FILE variables to the generated paths.
# CI/server: put base64 one-liner in JWT_RS256_PRIVATE_KEY instead of FILE.
SSO_SESSION_TTL_MS=2592000000 # optional, 30 days
APP_SESSION_TTL_MS=2592000000 # optional, 30 days
AUTHZ_CACHE_TTL_MS=300000 # optional

# Registered OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/social/google/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/social/github/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/social/discord/callback
DISCORD_GUILD_ID=
MEMBERSHIP_TTL_MS=900000 # optional, 15 minutes
ZALO_CLIENT_ID=
ZALO_CLIENT_SECRET=
ZALO_REDIRECT_URI=http://localhost:3000/api/auth/social/zalo/callback

# Optional TOTP encryption (falls back to JWT_SECRET if unset)
TOTP_ENCRYPTION_KEY= # optional

# Email via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="BCN Support <onboarding@uside.id.vn>"
MAIL_QUEUE_CONCURRENCY=5 # optional

# MinIO (client converts avatar to WebP before upload)
MINIO_AVATAR_FOLDER=user-avatars # optional
MINIO_IMAGE_MAX_BYTES=2097152 # optional

# Cache
USERS_LIST_CACHE_TTL_MS=60000 # optional
TIMELINE_CACHE_TTL_MS=60000 # optional

# Logging
LOG_LEVEL=info # optional
LOG_DIR=logs # optional
LOG_FILE_ENABLED=false # optional
LOKI_ENABLED=false # optional
LOKI_HOST= # optional
LOKI_BASIC_AUTH= # optional
LOKI_BATCH_INTERVAL_SECONDS=5 # optional
LOKI_TIMEOUT_MS=10000 # optional

# Local MinIO (docker compose). Production: https://storage.bcn.id.vn
MINIO_ENDPOINT=http://127.0.0.1:9010
MINIO_BUCKET=profiles
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1 # optional
MINIO_FORCE_PATH_STYLE=true
